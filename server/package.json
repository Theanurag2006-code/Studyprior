{
  "name": "studyprior-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StudyPrior API: zero npm dependencies. Needs Node 22.13+ (built-in SQLite).",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.mjs",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.mjs",
    "admin:create": "node --disable-warning=ExperimentalWarning scripts/create-admin.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "e2e": "npx tsx e2e/adapter.e2e.ts"
  }
}
