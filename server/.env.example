# Optional. The server works with NO configuration in development. Copy to server/.env and export these, or set them in your shell.
# (The server does not read .env files itself, so it needs no packages. Use:  set -a; . ./.env; set +a; npm start)
PORT=4000
# The ONE browser address allowed to call this API (the Vite dev server by default).
FRONTEND_ORIGIN=http://localhost:5173
# Where the SQLite database file lives (created automatically).
DB_PATH=data/studyprior.db
# Development: generated automatically and saved next to the database. Production: REQUIRED, 32+ random characters,
#   e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# true = new community subjects wait for an administrator's approval before anyone can rate them.
REQUIRE_SUBJECT_REVIEW=false
# Production only:  NODE_ENV=production  (turns on Secure cookies, requires https FRONTEND_ORIGIN and SESSION_SECRET)
