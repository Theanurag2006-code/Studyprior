{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "commonjs", "moduleResolution": "node", "outDir": "dist", "rootDir": ".",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "prisma/seed.ts", "scripts/*.ts", "vitest.*.config.ts"]
}
