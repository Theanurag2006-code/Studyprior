# Copy to backend/.env and edit. NEVER commit the real .env file.
NODE_ENV=development
PORT=4000
# Local development database (matches docker-compose.yml). Replace CHANGE_ME with the POSTGRES_PASSWORD you chose.
DATABASE_URL=postgresql://studyprior:CHANGE_ME@localhost:5432/studyprior?schema=public
# A SEPARATE database used only by automated tests; its name must contain "test".
DATABASE_URL_TEST=postgresql://studyprior:CHANGE_ME@localhost:5432/studyprior_test?schema=public
# Empty database used ONLY by `npm run db:check-drift` (Prisma resets it). Name must contain "shadow".
SHADOW_DATABASE_URL=postgresql://studyprior:CHANGE_ME@localhost:5432/studyprior_shadow?schema=public
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# The ONE browser origin allowed to call this API (the Vite dev server by default).
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=168
# lax is right when the site and API share a registrable domain. See docs/architecture.md for cross-site deployments.
COOKIE_SAMESITE=lax
TRUST_PROXY=0
LOG_LEVEL=info
